{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Bot availability",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "taskforge_up", "refId": "A" }]
    },
    {
      "title": "Discord latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [{ "expr": "taskforge_discord_latency_ms", "refId": "A" }]
    },
    {
      "title": "PostgreSQL availability",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "targets": [{ "expr": "taskforge_database_up", "refId": "A" }]
    },
    {
      "title": "CPU and memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "taskforge_process_cpu_percent",
          "legendFormat": "CPU %",
          "refId": "A"
        },
        {
          "expr": "taskforge_process_memory_bytes / 1024 / 1024",
          "legendFormat": "Memory MB",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Commands per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(taskforge_commands_total{status=\"success\"}[5m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active voice sessions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "taskforge_vc_active_sessions", "refId": "A" }]
    },
    {
      "title": "Economy transactions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum by (type) (rate(taskforge_economy_transactions_total[5m])) * 60",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["taskforge"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "TaskForge Bot",
  "uid": "taskforge-bot",
  "version": 1
}
